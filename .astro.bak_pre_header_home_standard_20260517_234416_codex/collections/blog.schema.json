{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "heroImage": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "sticky": {
      "default": false,
      "type": "boolean"
    },
    "stickyUntil": {
      "type": "string",
      "format": "date-time"
    },
    "wp_id": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categoria_macro": {
      "type": "string",
      "enum": [
        "geral",
        "politica",
        "lazer",
        "seguranca",
        "economia",
        "servicos"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}